# =============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Works out-of-the-box for local Docker Compose and standalone runs!
# Copy to .env:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# =============================================================================

# [CRITICAL SECURITY WARNING]
# The JWT_SECRET below is a safe development default for testing ONLY.
# You MUST change this secret to a random 32+ character key before any production
# or public cloud deployment (e.g., Render, Railway, AWS)!
JWT_SECRET=SafeLocalAcademicDevelopmentSecretKeyMin32Chars2026!
JWT_EXPIRATION_MS=86400000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fakenews_db
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root_secure_password

# Spring Boot Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (leave blank to use the local Vite reverse proxy)
VITE_API_BASE_URL=
